<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ОСНОВНОЙ КОНТЕНТ (СНОЛЛ) -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- БИЛЕТ БЕЗ ЭФФЕКТА КАРТОЧКИ (FLAT DESIGN) -->
            <LinearLayout
                android:id="@+id/layoutTicketContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ШАПКА БИЛЕТА (КЛИКАБЕЛЬНАЯ ДЛЯ РЕДАКТИРОВАНИЯ) -->
                <LinearLayout
                    android:id="@+id/layoutTicketHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#004B93"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <TextView
                        android:id="@+id/tvTicketHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.02"
                        android:text="VRN Ticket"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Verkehrsverbund Rhein-Neckar"
                        android:textColor="#B3D4FF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- СОДЕРЖИМОЕ БИЛЕТА -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- СТАТУС GÜLTIG В ЛЕВОЙ ЧАСТИ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="#E8F5E9"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="● GÜLTIG"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- БОЛЬШОЙ AZTEC-КОД -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivAztecCode"
                            android:layout_width="340dp"
                            android:layout_height="340dp"
                            android:contentDescription="Aztec Code" />
                    </LinearLayout>

                    <!-- ИНФОРМАЦИЯ О ПАССАЖИРЕ И БИЛЕТЕ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F8F9FA"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NAME DES INHABERS"
                            android:textColor="#777777"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPassengerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:fontFamily="monospace"
                            android:textColor="#111111"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GEBURTSDATUM"
                            android:textColor="#777777"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPassengerDob"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:fontFamily="monospace"
                            android:textColor="#222222"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="#E0E0E0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GÜLTIGKEITSZEITRAUM"
                            android:textColor="#777777"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvValidityInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:fontFamily="monospace"
                            android:textColor="#222222"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvTicketNumberInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#EEEEEE"
                            android:fontFamily="monospace"
                            android:padding="12dp"
                            android:textColor="#444444"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- ФОРМА ВВОДА (БЕЗ КАРТОЧКИ) -->
            <LinearLayout
                android:id="@+id/cardInputForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Daten bearbeiten"
                    android:textColor="#004B93"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Vorname"
                    android:inputType="textPersonName"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Nachname"
                    android:inputType="textPersonName"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Geburtsdatum (Datum wählen)"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etValidFrom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Gültig ab (z.B. 01.10.2026)"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etValidTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Gültig bis (z.B. 31.10.2026)"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#004B93"
                    android:text="Ticket erstellen"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- НИЖНЕЕ МЕНЮ НАВИГАЦИИ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:itemIconTint="#004B93"
        app:itemTextColor="#004B93"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
