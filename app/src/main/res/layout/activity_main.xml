<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7">

    <!-- 1. Отдельная шапка -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:backgroundTint="#005B9A"
        android:elevation="6dp"
        app:cornerSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTicketHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="VRN - Deutschlandticket"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 2. Единая карточка билета -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ticketCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- Статус Gültig -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="● GÜLTIG"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Плотный Aztec/QR код -->
            <ImageView
                android:id="@+id/qrCodeImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="240dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStatus"
                tools:srcCompat="@android:drawable/ic_menu_gallery" />

            <!-- Данные в 2 колонки -->
            <TableLayout
                android:id="@+id/dataTable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:stretchColumns="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/qrCodeImage">

                <!-- Ряд 1: Inhaber -->
                <TableRow android:paddingVertical="4dp">
                    <TextView
                        android:text="Inhaber"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvPassengerName"
                        android:gravity="end"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Max Mustermann" />
                </TableRow>

                <!-- Ряд 2: Geburtsdatum -->
                <TableRow android:paddingVertical="4dp">
                    <TextView
                        android:text="Geburtsdatum"
                        android:textColor="#666666"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvPassengerDob"
                        android:gravity="end"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        tools:text="01.01.1990" />
                </TableRow>

                <!-- Ряд 3: Gültig bis -->
                <TableRow android:paddingVertical="4dp">
                    <TextView
                        android:text="Gültig bis"
                        android:textColor="#666666"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvValidityInfo"
                        android:gravity="end"
                        android:textColor="#00875A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="31.10.2026" />
                </TableRow>

                <!-- Ряд 4: Ticket ID -->
                <TableRow android:paddingVertical="4dp">
                    <TextView
                        android:text="Ticket ID"
                        android:textColor="#666666"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvTicketNumberInfo"
                        android:gravity="end"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        tools:text="VRN-DT-89230492" />
                </TableRow>
            </TableLayout>

            <!-- Блок защиты от скриншотов с бегающим бликом -->
            <FrameLayout
                android:id="@+id/securityBlock"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:background="#1E293B"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataTable"
                app:layout_constraintVertical_bias="1.0">

                <View
                    android:id="@+id/shimmerBar"
                    android:layout_width="60dp"
                    android:layout_height="match_parent"
                    android:background="#99FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="• VRN Dynamic Security Check •"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Нижнее меню навигации -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="12dp"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
